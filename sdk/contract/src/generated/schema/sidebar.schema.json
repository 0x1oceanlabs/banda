{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sidebar.toml",
  "description": "How the sidebar arranges Threads: a preset, and the keys that change\nit. A preset file in sidebars/ takes the same keys; every key is\noptional.",
  "type": "object",
  "properties": {
    "preset": {
      "description": "Banda's inbox, projects or places, or one of yours in sidebars/.",
      "type": "string",
      "x-class": "shared"
    },
    "group": {
      "description": "How Threads fall into sections.",
      "$ref": "#/$defs/GroupSettings",
      "x-class": "shared"
    },
    "sort": {
      "description": "Their order in a section.",
      "$ref": "#/$defs/SortSettings",
      "x-class": "shared"
    },
    "projects": {
      "description": "The Projects above the Threads. `[spaces]` before ADR 0069 (grace).",
      "$ref": "#/$defs/ProjectsSettings",
      "x-class": "shared"
    },
    "row": {
      "description": "What a Thread's row shows.",
      "$ref": "#/$defs/RowSettings",
      "x-class": "shared"
    },
    "bar": {
      "description": "The counts in the bar's middle: who waits for you, who works.",
      "$ref": "#/$defs/BarSettings",
      "x-class": "shared"
    },
    "later": {
      "description": "The Later's presets (ADR 0074). `[snooze]` before ADR 0098 (grace).",
      "$ref": "#/$defs/LaterSettings",
      "x-class": "shared"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "GroupSettings": {
      "type": "object",
      "properties": {
        "by": {
          "description": "What makes a section: a Thread's state, its Project, or nothing.",
          "$ref": "#/$defs/GroupBy"
        },
        "states": {
          "description": "The sections by state, in this order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/State"
          }
        },
        "bottom": {
          "description": "Shelves at the bottom, each with its count.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/State"
          }
        },
        "folded": {
          "description": "Sections, shelves or Projects (by name) that start folded.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limit": {
          "description": "Rows a section shows before \"Show more\"; 0 shows all.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "empty": {
          "description": "What an empty section does.",
          "$ref": "#/$defs/Empty"
        }
      },
      "additionalProperties": false
    },
    "GroupBy": {
      "oneOf": [
        {
          "description": "Sections by what each Thread's mark says.",
          "type": "string",
          "const": "state"
        },
        {
          "description": "Each Project a section of its own. `space` before ADR 0069 (grace).",
          "type": "string",
          "const": "project"
        },
        {
          "description": "One list.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "State": {
      "description": "A Thread's mark as the sidebar sees it.",
      "oneOf": [
        {
          "description": "Neither at work nor archived: it asks, it failed, it finished, or\nthe Person has it in hand.",
          "type": "string",
          "const": "active"
        },
        {
          "description": "Its Agent is at work.",
          "type": "string",
          "const": "working"
        },
        {
          "description": "Put away until a time, or until its turn ends (ADR 0074).\n`snoozed` before ADR 0098 (grace).",
          "type": "string",
          "const": "later"
        },
        {
          "description": "Put away by the Person, until something new happens in it\n(ADR 0069). Its name was `settled`, which still reads as it.\n`settled` before ADR 0069 (grace).",
          "type": "string",
          "const": "archived"
        }
      ]
    },
    "Empty": {
      "oneOf": [
        {
          "description": "Left out.",
          "type": "string",
          "const": "hide"
        },
        {
          "description": "Shown with its title.",
          "type": "string",
          "const": "show"
        }
      ]
    },
    "SortSettings": {
      "type": "object",
      "properties": {
        "by": {
          "description": "What comes first in a section.",
          "$ref": "#/$defs/SortBy"
        }
      },
      "additionalProperties": false
    },
    "SortBy": {
      "oneOf": [
        {
          "description": "What needs the Person first, then the latest change.",
          "type": "string",
          "const": "attention"
        },
        {
          "description": "The latest change first.",
          "type": "string",
          "const": "changed"
        },
        {
          "description": "By title, A to Z.",
          "type": "string",
          "const": "title"
        }
      ]
    },
    "ProjectsSettings": {
      "type": "object",
      "properties": {
        "list": {
          "description": "A list of Projects above the Threads.",
          "type": "boolean"
        },
        "order": {
          "description": "The order of that list.",
          "$ref": "#/$defs/ProjectOrder"
        },
        "rollup": {
          "description": "A Project shows its loudest mark and how many need you.",
          "type": "boolean"
        },
        "new-thread": {
          "description": "Each Project offers a new Thread in it.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ProjectOrder": {
      "oneOf": [
        {
          "description": "The Project with the latest change first.",
          "type": "string",
          "const": "changed"
        },
        {
          "description": "By name, A to Z.",
          "type": "string",
          "const": "name"
        }
      ]
    },
    "RowSettings": {
      "type": "object",
      "properties": {
        "lines": {
          "description": "1, 2 or 3: one of Banda's layouts.",
          "type": "integer",
          "format": "uint8",
          "minimum": 1,
          "maximum": 3
        },
        "hide": {
          "description": "Parts the layout leaves out.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part"
          }
        },
        "line1": {
          "description": "The first line of a layout of your own, which replaces the lines'.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part"
          }
        },
        "line2": {
          "description": "Its second line.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part"
          }
        },
        "line3": {
          "description": "Its third line.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part"
          }
        }
      },
      "additionalProperties": false
    },
    "Part": {
      "description": "A part of a row; `~` pushes the rest of its line to the right.",
      "oneOf": [
        {
          "description": "The Thread's mark.",
          "type": "string",
          "const": "mark"
        },
        {
          "description": "Its title.",
          "type": "string",
          "const": "title"
        },
        {
          "description": "Its Project. `space` before ADR 0069 (grace).",
          "type": "string",
          "const": "project"
        },
        {
          "description": "Its Harness.",
          "type": "string",
          "const": "harness"
        },
        {
          "description": "What it does now, and when it last changed.",
          "type": "string",
          "const": "status"
        },
        {
          "description": "The last thing said.",
          "type": "string",
          "const": "note"
        },
        {
          "description": "Pushes the rest of the line to the right.",
          "type": "string",
          "const": "~"
        }
      ]
    },
    "BarSettings": {
      "type": "object",
      "properties": {
        "show": {
          "description": "When they show.",
          "$ref": "#/$defs/BarShow"
        },
        "counts": {
          "description": "What is counted, in this order; a count of none is left out.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Count"
          }
        },
        "color": {
          "description": "A question in the attention colour, a failure in red, done in green.",
          "type": "boolean"
        },
        "words": {
          "description": "Words beside the numbers.",
          "type": "boolean"
        },
        "empty": {
          "description": "What shows with nothing to count.",
          "$ref": "#/$defs/BarEmpty"
        }
      },
      "additionalProperties": false
    },
    "BarShow": {
      "description": "When the bar's middle shows the sidebar's counts.",
      "oneOf": [
        {
          "description": "While the sidebar is closed: it shows the same.",
          "type": "string",
          "const": "closed"
        },
        {
          "description": "Always, the sidebar open or not.",
          "type": "string",
          "const": "always"
        },
        {
          "description": "Never.",
          "type": "string",
          "const": "never"
        }
      ]
    },
    "Count": {
      "description": "What the bar's middle counts, each with its mark.",
      "oneOf": [
        {
          "description": "Threads that ask the Person, or failed: they need an answer.",
          "type": "string",
          "const": "asking"
        },
        {
          "description": "Threads that finished and the Person has not seen.",
          "type": "string",
          "const": "done"
        },
        {
          "description": "Both of those: every Thread that waits for the Person.",
          "type": "string",
          "const": "waiting"
        },
        {
          "description": "Threads at work.",
          "type": "string",
          "const": "working"
        }
      ]
    },
    "BarEmpty": {
      "description": "What the bar's middle shows with nothing to count.",
      "oneOf": [
        {
          "description": "Nothing.",
          "type": "string",
          "const": "hide"
        },
        {
          "description": "The calm square: the counts stay in their place.",
          "type": "string",
          "const": "mark"
        }
      ]
    },
    "LaterSettings": {
      "type": "object",
      "properties": {
        "presets": {
          "description": "The times the Later's picker offers, in its field's words, up to\neight: \"1h\", \"18:00\", \"tomorrow 9:00\", \"mon 9:00\".",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
