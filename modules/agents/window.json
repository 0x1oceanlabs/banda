          "code": "Enter",
          "shift": true
        }
      ],
      "scope": "composer"
    },
    {
      "id": "agents.composer.back",
      "title": "The message sent before, from the first line",
      "section": "Composer",
      "keys": [
        {
          "code": "ArrowUp"
        }
