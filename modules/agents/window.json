      "args": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "description": "the Project it starts in"
          },
          "ask": {
            "type": "string",
            "description": "what to write to its Agent first"
          },
          "harness": {
            "type": "string",
            "description": "the Harness it starts on"
          }
        },
        "additionalProperties": false
      },
      "runsAsPerson": [
        "ask"
      ]
    },
    {
      "id": "agents.answer",
      "title": "Answer a Question",
      "section": "Threads",
      "keys": [],
      "unlisted": true
    },
    {
      "id": "agents.retry",
      "title": "Try a turn again",
      "section": "Threads",
      "keys": [],
      "unlisted": true
    },
    {
      "id": "agents.show",
      "title": "Show a Thread",
      "section": "Threads",
      "keys": [],
      "unlisted": true
    },
    {
