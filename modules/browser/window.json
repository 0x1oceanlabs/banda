            "type": "string",
            "description": "a page's address"
          },
          "file": {
            "type": "string",
            "description": "a file's absolute path, to show"
          },
          "words": {
            "type": "string",
            "description": "words to search the web for"
          },
          "project": {
            "type": "string",
            "description": "the Project to open it in"
          }
        },
        "additionalProperties": false
      }
