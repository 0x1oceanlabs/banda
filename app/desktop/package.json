{
  "name": "@banda/desktop",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "The desktop window: Electron runs the engine and shows the page.",
  "main": "out/main.mjs",
  "scripts": {
    "build": "pnpm --filter @banda/web build && node build.mjs",
    "dev": "node build.mjs && BANDA_PAGE=http://localhost:5173/ electron .",
    "start": "node build.mjs && electron .",
    "e2e": "pnpm build && playwright test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src"
  },
  "devDependencies": {
    "@banda/agents-desktop": "workspace:*",
    "@banda/browser-desktop": "workspace:*",
    "@banda/browser-pane": "workspace:*",
    "@banda/contract": "workspace:*",
    "@banda/desktop-kit": "workspace:*",
    "@banda/web": "workspace:*",
    "@effect/vitest": "4.1.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "@ghostery/adblocker-electron": "2.20.3",
    "effect": "4.1.1",
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0",
    "electron-updater": "6.8.11",
    "playwright-core": "1.64.1"
  }
}
