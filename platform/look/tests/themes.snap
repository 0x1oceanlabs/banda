# What `banda look` resolves for Banda's own themes: written by
# tests/themes.rs, which says how to write it again.

[banda banda look themes]
themes.0.mode = light
themes.0.name = banda-light
themes.0.origin = banda
themes.1.mode = dark
themes.1.name = banda-dark
themes.1.origin = banda
themes.2.mode = light
themes.2.name = macos-light
themes.2.origin = banda
themes.3.mode = dark
themes.3.name = macos-dark
themes.3.origin = banda

[banda mode=light glass=on]
mode = light
desk.glass = true
desk.material = banda
desk.sidebar = panel
desk.wallpaper.from = look.toml
desk.wallpaper.modified = 0
desk.wallpaper.path = <dir>/banda/wall.png
vars.--bar-height = 36px
vars.--card-radius = 14px
vars.--control-radius = 10px
vars.--desk-blur = 40px
vars.--desk-grain = 0.04
vars.--desk-opacity = 40%
vars.--desk-saturation = 1.4
vars.--focus-ring = 0px
vars.--focus-shadow-strength = 0.25
vars.--font-family-mono = "JetBrains Mono Variable", monospace
vars.--font-family-sans = "Inter Variable", sans-serif
vars.--gap-inner = 8px
vars.--gap-outer = 8px
vars.--sidebar-shadow-strength = 0.45
vars.--small-radius = 6px
vars.--text-root = 16px
vars.--tile-border = 1px
vars.--tile-dim = 0
vars.--tile-opacity = 100%
vars.--tile-radius = 22px
vars.--tile-shadow-strength = 0
vars.--window-radius = 30px
