{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npx --yes pnpm@11.28.9 install --frozen-lockfile --filter @banda/site...",
  "buildCommand": "npx --yes pnpm@11.28.9 run build",
