---
// "Shape is state": the gang one by one, each a small canvas with its
// wall label, as the Mark's states are (ADR 0099).
import Character from "./Character.astro"
import type { GangState } from "../lib/paint"

interface Member {
  state: GangState
  shape: string
  name: string
  says: string
  sky: string
}

const cast: Member[] = [
  {
    state: "calm",
    shape: "Square",
    name: "Calm",
    says: "Nothing needs you.",
    sky: "var(--paint-ground-2)",
  },
  {
    state: "working",
    shape: "Circle",
    name: "Working",
    says: "At work. Leave it be.",
    sky: "var(--paint-cobalt)",
  },
  {
    state: "asks",
    shape: "Triangle",
    name: "Your turn",
    says: "It asks you.",
    sky: "var(--paint-soot)",
  },
  {
    state: "failed",
    shape: "Octagon",
    name: "Failed",
    says: "Look here first.",
    sky: "var(--paint-slate)",
  },
  {
    state: "done",
    shape: "Square, green",
    name: "Done",
    says: "Finished. Read it.",
    sky: "var(--paint-cadmium)",
  },
  {
    state: "woke",
    shape: "Square, yellow",
    name: "Woke",
    says: "Back from Later.",
    sky: "var(--paint-cobalt)",
  },
]

const sky = (i: number) =>
  `M-20 -20 H420 V${250 + ((i * 37) % 60)} C300 ${300 + ((i * 23) % 40)} 120 ${220 + ((i * 41) % 70)} -20 ${280 - ((i * 19) % 40)} Z`
const sweep = (i: number) =>
  `M-20 ${150 + i * 12} C120 ${110 + i * 9} 260 ${190 - i * 6} 420 ${140 + i * 4}`
---

<section class="s" id="cast" aria-labelledby="cast-title">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="num">
          <span>01</span>
          <i></i>
          <span>The cast</span>
        </p>
        <h2 id="cast-title">Shape is state.</h2>
      </div>
      <p>
        Every Agent wears what it needs from you. Square, calm. Circle, at work.
        Triangle, your turn. Octagon, it failed. You read the room before you
        read a word, and it reads without colour too.
      </p>
    </div>
    <ul class="cast">
      {cast.map((m, i) => (
        <li>
          <div class="mini">
            <svg
              class="art"
              viewBox="0 0 400 500"
              preserveAspectRatio="xMidYMid slice"
              aria-hidden="true"
            >
              <rect width="400" height="500" style="fill:var(--paint-ground)" />
              <g filter="url(#paint)">
                <path d={sky(i)} style={`fill:${m.sky}`} />
                <path
                  d="M-20 452 C120 444 260 458 420 448 V520 H-20 Z"
                  style="fill:var(--paint-green)"
                />
              </g>
              <g
                filter="url(#gesso)"
                fill="none"
                style="stroke:var(--paint-gesso)"
                stroke-linecap="round"
              >
                <path d={sweep(i)} stroke-width="40" />
                <path
                  d="M60 380 C160 330 300 360 420 300"
                  stroke-width="30"
                  opacity=".8"
                />
              </g>
            </svg>
            <Character
              states={m.state}
              at={[200, 262]}
              scale={1.04}
              box={[400, 500]}
              legs
              sat={m.state === "working"}
              drips={i % 2 === 0}
              arm={m.state === "asks"}
              seed={i + 3}
            />
          </div>
          <p class="cap">
            <span class="no">
              No. {i + 1} · {m.shape}
            </span>
            <b>{m.name}</b>
            {m.says}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .s {
    padding: clamp(72px, 9vw, 136px) 0 clamp(96px, 12vw, 176px);
    border-top: 1px solid var(--gallery-line);
  }
  .head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .head > p {
    margin: 0;
    color: var(--gallery-ink-2);
    font-size: clamp(17px, 1.3vw, 19px);
    line-height: 1.55;
    max-width: 40ch;
  }
  .num {
    font-family: var(--font-family-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gallery-muted);
    margin: 0 0 18px;
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .num i {
    width: 28px;
    height: 1px;
    background: var(--gallery-ink);
  }
  h2 {
    font-size: clamp(44px, 6.2vw, 96px);
    line-height: 0.9;
    letter-spacing: -0.055em;
    font-weight: 800;
    margin: 0;
    text-wrap: balance;
  }
  @media (max-width: 820px) {
    .head {
      grid-template-columns: 1fr;
    }
  }
  .cast {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(14px, 1.6vw, 24px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cast li {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .mini {
    aspect-ratio: 4 / 5;
    background: var(--paint-ground);
    position: relative;
    box-shadow:
      8px 12px 22px -12px rgb(0 0 0 / 0.32),
      1px 2px 4px rgb(0 0 0 / 0.08);
  }
  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    will-change: transform;
  }
  .cap {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
    color: var(--gallery-ink-2);
  }
  .cap b {
    display: block;
    color: var(--gallery-ink);
    font-size: 14.5px;
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .cap .no {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 10.5px;
    color: var(--gallery-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  @media (max-width: 980px) {
    .cast {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .cast {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 14px;
    }
  }
</style>
