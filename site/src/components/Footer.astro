---
// The floor: the painting's green strip, painted along the page's foot.
const repo = "https://github.com/0x1oceanlabs/banda"
---

<svg
  class="floor"
  viewBox="0 0 1440 72"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <g filter="url(#paint)">
    <path
      d="M-20 34 C240 22 520 40 820 26 C1040 16 1260 34 1460 22 V90 H-20 Z"
      style="fill:var(--paint-green)"
    ></path>
  </g>
  <g
    filter="url(#wob)"
    style="stroke:var(--paint-green)"
    stroke-linecap="round"
  >
    <path d="M210 40 V70" stroke-width="5"></path>
    <path d="M900 30 V64" stroke-width="5"></path>
  </g>
</svg>
<footer>
  <div class="wrap row">
    <a class="brand" href="#top">
      <span class="logo" data-mark="done" data-logo data-size="24"></span>
      Banda
    </a>
    <ul>
      <li>
        <a href="https://banda.so">banda.so</a>
      </li>
      <li>
        <a href={repo}>GitHub</a>
      </li>
      <li>
        <a href={`${repo}/blob/main/LICENSE`}>Apache-2.0</a>
      </li>
    </ul>
  </div>
</footer>

<script>
  import { stillOffscreen } from "../lib/mark"

  stillOffscreen(document.querySelector("footer")!)
</script>

<style>
  .floor {
    display: block;
    width: 100%;
    height: clamp(44px, 5vw, 72px);
    margin-bottom: -1px;
  }
  footer {
    background: var(--paint-green);
    color: var(--gallery-plate);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-top: 8px;
    padding-bottom: 36px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 750;
    font-size: 19px;
    letter-spacing: -0.02em;
  }
  /* All of the Mark in the plate's white, the done hat too: its green
     would sink into the green strip. */
  .logo {
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
    --logo-tiles: var(--gallery-plate);
    --added: var(--gallery-plate);
  }
  ul {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-family-mono);
    font-size: 12.5px;
    flex-wrap: wrap;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  footer :focus-visible {
    outline-color: var(--gallery-plate) !important;
  }
</style>
