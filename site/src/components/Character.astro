---
// One of the gang: a painted Agent whose shape is its state. It is drawn
// in layers stacked in one box: a still body for each state it can take
// (painted, under the costly filter, drawn once), the open eyes (no
// filter, so the pupils can follow the pointer cheaply) and a satellite
// that circles it while it works. Its motions move whole layers, which
// the browser composes without painting them again.
import {
  body,
  drips,
  extras,
  eyeKind,
  eyeWhites,
  legs,
  pupils,
  satellite,
  stillEyes,
  VIEW,
  VIEWBOX,
  type GangState,
} from "../lib/paint"

interface Props {
  /** Its state, or the states it moves between: the first shows. */
  states: GangState | GangState[]
  /** Its centre and scale in the picture's units. */
  at: [number, number]
  scale?: number
  /** The picture's size in its own units, to place it in percent. */
  box: [number, number]
  legs?: boolean
  sat?: boolean
  drips?: boolean
  arm?: boolean
  seed?: number
  /** Where the eyes look when nobody points: the headline, or around. */
  gaze?: "headline" | "idle"
}

const {
  at: [x, y],
  scale = 1,
  box: [width, height],
  seed = 1,
  gaze = "idle",
} = Astro.props
const states = [Astro.props.states].flat()
const first = states[0]
const hasOpenEyes = states.some((state) => eyeKind(state) === "open")
const hasSat = Astro.props.sat && states.includes("working")

const percent = (n: number) => `${(n * 100).toFixed(3)}%`
const place = [
  `left:${percent((x + VIEW.x * scale) / width)}`,
  `top:${percent((y + VIEW.y * scale) / height)}`,
  `width:${percent((VIEW.w * scale) / width)}`,
  `height:${percent((VIEW.h * scale) / height)}`,
].join(";")

const still = (state: GangState) =>
  (Astro.props.legs ? legs(seed) : "") +
  body(state) +
  (Astro.props.drips ? drips(state, seed) : "") +
  extras(state, !!Astro.props.arm) +
  stillEyes(eyeKind(state))
---

<div
  class="ch"
  style={place}
  data-state={first}
  data-eyes={eyeKind(first)}
  data-gaze={gaze}
  aria-hidden="true"
>
  <div class="ch-mot">
    {hasSat && (
      <svg class="ch-layer ch-sat" viewBox={VIEWBOX}>
        <Fragment set:html={satellite("working")} />
      </svg>
    )}
    {states.map((state) => (
      <svg
        class:list={["ch-layer ch-body", { on: state === first }]}
        data-s={state}
        viewBox={VIEWBOX}
      >
        <g filter="url(#body)" set:html={still(state)} />
      </svg>
    ))}
    {hasOpenEyes && (
      <svg class="ch-layer ch-eyes" viewBox={VIEWBOX}>
        <Fragment set:html={eyeWhites(seed)} />
        <g class="pupils" set:html={pupils()} />
      </svg>
    )}
  </div>
</div>

<style>
  .ch {
    position: absolute;
    pointer-events: none;
  }
  .ch-mot {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .ch-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  /* One body shows at a time; the next one springs up in its place. */
  .ch-body {
    opacity: 0;
    transform: scale(0.82, 0.7);
    transform-origin: 50% 72%;
    transition:
      opacity 0.38s ease,
      transform 0.5s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .ch-body.on {
    opacity: 1;
    transform: none;
  }
  .ch-eyes {
    transform-origin: 50% 53.3%;
    transition: opacity 0.25s;
  }
  .ch:not([data-eyes="open"]) .ch-eyes {
    opacity: 0;
  }
  .ch-sat {
    opacity: 0;
    transition: opacity 0.3s;
  }
  .ch[data-state="working"] .ch-sat {
    opacity: 1;
    animation: orbit 7s linear infinite;
  }

  /* Each state has its motion: who asks hops, who failed shakes, the calm
     ones breathe. */
  .ch[data-state="asks"] .ch-mot {
    animation: hop 4.4s cubic-bezier(0.3, 0.7, 0.4, 1) infinite;
  }
  .ch[data-state="failed"] .ch-mot {
    transform-origin: 50% 90%;
    animation: shake 4.4s ease-in-out infinite;
  }
  .ch:is([data-state="calm"], [data-state="later"]) .ch-mot {
    transform-origin: 50% 100%;
    animation: breathe 5s ease-in-out infinite;
  }
  .ch.blink .ch-eyes {
    animation: blink 0.16s ease-in-out;
  }

  @keyframes hop {
    0%,
    82%,
    100% {
      transform: translateY(0);
    }
    88% {
      transform: translateY(-6%);
    }
    93% {
      transform: translateY(0);
    }
    96% {
      transform: translateY(-2%);
    }
  }
  @keyframes shake {
    0%,
    84%,
    100% {
      transform: rotate(0);
    }
    86% {
      transform: rotate(-6deg);
    }
    88% {
      transform: rotate(5deg);
    }
    90% {
      transform: rotate(-4deg);
    }
    92% {
      transform: rotate(3deg);
    }
    94% {
      transform: rotate(0);
    }
  }
  @keyframes breathe {
    50% {
      transform: scale(1.025, 0.975);
    }
  }
  @keyframes orbit {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes blink {
    50% {
      transform: scaleY(0.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ch .ch-mot,
    .ch .ch-sat,
    .ch.blink .ch-eyes {
      animation: none !important;
    }
    .ch-body {
      transition: none;
    }
  }
</style>
