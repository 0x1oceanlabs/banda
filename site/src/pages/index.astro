---
import Cast from "../components/Cast.astro"
import Dive from "../components/Dive.astro"
import Footer from "../components/Footer.astro"
import Hero from "../components/Hero.astro"
import Inbox from "../components/Inbox.astro"
import Install from "../components/Install.astro"
import Machines from "../components/Machines.astro"
import Night from "../components/Night.astro"
import OwnAgents from "../components/OwnAgents.astro"
import PaintBox from "../components/PaintBox.astro"
import Panes from "../components/Panes.astro"
import Page from "../layouts/Page.astro"

// banda.so's home: two worlds. The gallery wall, where the gang hangs as
// a painting, and Banda's dark desk, where the same gang works as Marks.
// The page dives from one into the other and comes back to install.
---

<Page
  title="Banda: lead the gang"
  description="Banda is a tiling workspace for working with many Agents at once: Claude Code and Codex beside your terminal, browser, files and diff, on your own machines. Open source."
  bodyClass="gallery"
>
  <PaintBox />
  <Hero />
  <main>
    <Cast />
    <Night>
      <Dive slot="dive" />
      <Inbox />
      <Panes />
      <Machines />
      <OwnAgents />
    </Night>
    <Install />
  </main>
  <Footer />
</Page>
